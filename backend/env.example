# このファイルを backend/.env にコピーして値を埋める。
#   cp env.example .env
# .env は .gitignore 済みでコミットされない。実際のキーをこの env.example に書かないこと。

# Gemini API キー（必須。https://aistudio.google.com/apikey で発行）
GOOGLE_API_KEY=your-gemini-api-key-here

# 使用モデル（省略時は llm.DEFAULT_MODEL）
# ここに書かなくても切り替えられる:
#   ターミナル … quiz --list-models（使えるモデル一覧） / quiz --model <名前>
#   VSCode 拡張 … ステータスバーのモデル名、またはコマンド「使用するモデルを選択」
# 退役したモデルは新規プロジェクトのAPIキーからは 404 になるため、古い名前を
# 指定しないこと。使える一覧は quiz --list-models で確認できる。
# QQQ_MODEL=gemini-3.5-flash

# Web検索用 Tavily API キー（任意。無ければ DuckDuckGo にフォールバック）
# TAVILY_API_KEY=your-tavily-api-key-here

# サーバのポート（省略時 8756）
# QQQ_PORT=8756

# APIキーなしで全フローを試すデモモード
# QQQ_FAKE_LLM=1
